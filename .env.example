GEMINI_API_KEY=
# Widget console (/console)
ADMIN_PASSWORD=
# Cloudflare KV namespace id for widget storage (npx wrangler kv namespace create WIDGETS).
# Not needed for `npm run dev`, which stores widgets in .data/widgets.json.
WIDGETS_KV_ID=
# Optional: model used to draft prompts from a website URL (default gemini-2.5-flash)
GEMINI_TEXT_MODEL=
