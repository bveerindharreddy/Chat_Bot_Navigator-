GEMINI_API_KEY=
# Widget console (/console)
ADMIN_PASSWORD=
# Optional: separate key for signing admin sessions (defaults to ADMIN_PASSWORD). Change it to sign everyone out.
SESSION_SECRET=
# Cloudflare KV namespace id for widget storage (npx wrangler kv namespace create WIDGETS).
# Not needed for `npm run dev`, which stores widgets in .data/widgets.json.
WIDGETS_KV_ID=
# Cloudflare D1 database id for usage, credits and billing (npx wrangler d1 create widget-usage).
# Not needed for `npm run dev`, which uses .data/usage.sqlite.
WIDGETS_D1_ID=
# Optional: model used to draft prompts from a website URL (default gemini-2.5-flash)
GEMINI_TEXT_MODEL=
